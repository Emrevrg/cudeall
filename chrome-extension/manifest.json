{
  "manifest_version": 3,
  "name": "opencode-all",
  "version": "0.2.0",
  "description": "cudeall MCP koprusu: sekme gruplarini acar, sayfa okur, tiklar/yazar. Tum isler 'CudeAll' grubunda toplanir.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "cudeall"
  }
}
